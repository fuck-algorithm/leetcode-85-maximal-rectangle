{
  "name": "leetcode-85-maximal-rectangle",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 54321",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b --pretty false",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --workers=1",
    "test:e2e:install": "playwright install chromium",
    "qa:guard": "node scripts/qa-guard.mjs",
    "qa:full": "npm run qa:guard && npm run lint && npm run type-check && npm run build && npm run test:coverage && npm run test:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "idb": "^8.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.64.1",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vitest": "^3.2.7"
  }
}
